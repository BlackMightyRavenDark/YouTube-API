<Window x:Class="YouTubeApiLib.GuiTestWPF.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:YouTubeApiLib.GuiTestWPF"
		mc:Ignorable="d"
		Title="GUI test (WPF)" Height="450" Width="800">
	<Window.DataContext>
		<local:ViewModelMainWindow />
	</Window.DataContext>

	<Window.Resources>
		<local:BoolInverseConverter x:Key="boolInverser" />
	</Window.Resources>

	<Grid>
		<TabControl>
			<TabItem Header="Поиск">
				<StackPanel>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="auto" />
							<RowDefinition />
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0">
							<Label Content="Введите ссылку на видео или его ID:"
								   Padding="4 2 0 0" />

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition Width="auto" />
								</Grid.ColumnDefinitions>

								<TextBox Text="{Binding VideoId}"
										 Margin="4 4 0 4" />
								<Button Content="Искать"
										Command="{Binding CommandFindVideo}"
										IsEnabled="{Binding IsVideoSearching, Converter={StaticResource boolInverser}}"
										Grid.Column="1"
										Padding="6 0"
										Margin="5" />
							</Grid>
						</StackPanel>
					</Grid>

					<Grid Visibility="{Binding ResultVisibility}"
						  Grid.Row="1">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="auto" />
								<RowDefinition />
							</Grid.RowDefinitions>

							<StackPanel Orientation="Horizontal"
										VerticalAlignment="Center"
										Height="120">
								<Border Background="LightGray"
										BorderBrush="Black"
										BorderThickness="2"
										Margin="4 0">
									<Border.ContextMenu>
										<ContextMenu>
											<MenuItem Header="Копировать ссылку на картинку"
													  Command="{Binding CommandCopyThumbnailUrl}" />
											<MenuItem Header="Открыть картинку в браузере"
													  Command="{Binding CommandOpenThumbnailInBrowser}" />
											<Separator />
											<MenuItem Header="Открыть видео в браузере"
													  Command="{Binding CommandOpenVideoInBrowser}" />
										</ContextMenu>
									</Border.ContextMenu>

									<Image Source="{Binding VideoThumbnail}"
										   Width="180"
										   Height="120" />
								</Border>

								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition Height="auto" />
										<RowDefinition Height="auto" />
									</Grid.RowDefinitions>

									<Border>
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Копировать название"
														  Command="{Binding CommandCopyVideoTitle}" />
											</ContextMenu>
										</Border.ContextMenu>

										<Label Content="{Binding VideoTitle}"
											   Padding="2 0 0 0"
											   Grid.Row="0" />
									</Border>
									<Label Content="{Binding VideoChannelOwnerTitle}"
										   Padding="2 0 0 0"
										   Grid.Row="1" />
									<Label Content="{Binding VideoPublishDateFormatted}"
										   Padding="2 0 0 0"
										   Grid.Row="2" />
								</Grid>
							</StackPanel>

							<GroupBox Header="Форматы"
									  Grid.Row="1">
								<DockPanel>
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="auto" />
											<RowDefinition />
										</Grid.RowDefinitions>

										<Label Content="{Binding FormattedApiClientId}"
											   Grid.Row="0" />
										<Button Content="Обновить"
												Command="{Binding CommandUpdateFormatList}"
												IsEnabled="{Binding IsFormatListSearching, Converter={StaticResource boolInverser}}"
												HorizontalAlignment="Right"
												Padding="6 0"
												Grid.Row="0" />
										<DataGrid ItemsSource="{Binding MediaTracks}"
												  AutoGenerateColumns="False"
												  CanUserAddRows="False"
												  CanUserDeleteRows="False"
												  CanUserResizeRows="False"
												  IsReadOnly="True"
												  IsSynchronizedWithCurrentItem="True"
												  Margin="0 4 0 0"
												  Grid.Row="1">
											<DataGrid.RowStyle>
												<Style TargetType="DataGridRow">
													<Setter Property="Background"
															Value="{Binding RowBackgroundColor}" />
												</Style>
											</DataGrid.RowStyle>

											<DataGrid.InputBindings>
												<MouseBinding
													MouseAction="LeftDoubleClick"
													Command="{Binding CommandMediaTrackListLeftDoubleClick}"
													CommandParameter="{Binding MediaTracks/}" />
											</DataGrid.InputBindings>

											<DataGrid.Columns>
												<DataGridTextColumn Header="Type"
																	Binding="{Binding Type}" />
												<DataGridTextColumn Header="Format ID"
																	Binding="{Binding FormatId}" />
												<DataGridTextColumn Header="Resolution"
																	Binding="{Binding Resolution}"/>
												<DataGridTextColumn Header="Frame rate"
																	Binding="{Binding FrameRate}"/>
												<DataGridTextColumn Header="File size"
																	Binding="{Binding FormattedFileSize}" />
												<DataGridTextColumn Header="Language"
																	Binding="{Binding Language}" />
											</DataGrid.Columns>
										</DataGrid>
									</Grid>
								</DockPanel>
							</GroupBox>
						</Grid>
					</Grid>
				</StackPanel>
			</TabItem>

			<TabItem Header="Настройки">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="auto" />
						<RowDefinition />
						<RowDefinition Height="auto" />
					</Grid.RowDefinitions>

					<Label Content="Введите список куков (JSON array):"
						   Grid.Row="0" />
					<TextBox Text="{Binding CookieInput}"
							 AcceptsReturn="True"
							 Grid.Row="1" />
					<Button Content="Применить куки"
							Command="{Binding CommandApplyCookies}"
							Grid.Row="2" />
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
